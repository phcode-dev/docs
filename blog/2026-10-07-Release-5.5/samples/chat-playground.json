      "script": "\n  let s = ui.getState() || {};\n  s.layout = s.layout || 'editorial';\n  s.palette = s.palette || 'clay';\n  s.size = s.size || 36;\n\n  function render() {\n    ui.attr('#pg', 'data-layout', s.layout);\n    ui.attr('#pg', 'data-palette', s.palette);\n    ui.attr('#pg', 'style', '--hs:' + s.size + 'px');\n    ui.text('#sz', s.size + 'px');\n    ui.value('#size', s.size);\n  }\n\n  ['editorial', 'split', 'poster'].forEach(function (id) {\n    ui.on('#l-' + id, 'click', function () { s.layout = id; render(); ui.setState(s); });\n  });\n  ['clay', 'midnight', 'moss', 'bloom'].forEach(function (id) {\n    ui.on('#p-' + id, 'click', function () { s.palette = id; render(); ui.setState(s); });\n  });\n  ui.on('#size', 'input', function (e) {\n    s.size = parseInt(e.value, 10) || 36;\n    render();\n    ui.setState(s);\n  });\n\n  render();\n\n",
