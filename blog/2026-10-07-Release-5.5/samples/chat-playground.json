      "html": "<style>\n  .pg{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;color:#e0e0e0;max-width:560px}\n  .controls{display:grid;gap:8px;padding:10px 12px;margin-bottom:10px;background:#1c1c1c;border:1px solid #3a3a3a;border-radius:10px}\n  .row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n  .lab{width:58px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#9a9a9a}\n  .seg{display:flex;background:#2a2a2a;border-radius:7px;padding:2px;gap:2px}\n  .seg button{font:inherit;font-size:12px;padding:5px 10px;border:0;border-radius:5px;background:transparent;color:#cfcfcf;cursor:pointer}\n  .seg button:hover{background:#3a3a3a;color:#fff}\n  .seg button:focus-visible,.sw:focus-visible{outline:2px solid #8ab4ff;outline-offset:2px}\n  .pg[data-layout=\"editorial\"] #l-editorial,\n  .pg[data-layout=\"split\"] #l-split,\n  .pg[data-layout=\"poster\"] #l-poster{background:#e8e8e8;color:#111}\n  .sws{display:flex;gap:8px}\n  .sw{width:26px;height:26px;border-radius:50%;border:2px solid #1c1c1c;box-shadow:0 0 0 1px #555;cursor:pointer;padding:0}\n  .sw:hover{box-shadow:0 0 0 2px #aaa}\n  #p-clay{background:linear-gradient(135deg,#f3ead9 50%,#d9572b 50%)}\n  #p-midnight{background:linear-gradient(135deg,#0e1326 50%,#c6f24e 50%)}\n  #p-moss{background:linear-gradient(135deg,#e6ecd9 50%,#2f6b4a 50%)}\n  #p-bloom{background:linear-gradient(135deg,#ffe3ea 50%,#e0245e 50%)}\n  .pg[data-palette=\"clay\"] #p-clay,.pg[data-palette=\"midnight\"] #p-midnight,\n  .pg[data-palette=\"moss\"] #p-moss,.pg[data-palette=\"bloom\"] #p-bloom{box-shadow:0 0 0 2px #fff}\n  .row input[type=range]{flex:1;min-width:90px;accent-color:#e8e8e8}\n  #sz{font-size:12px;color:#cfcfcf;width:38px;text-align:right;font-variant-numeric:tabular-nums}\n\n  .pg[data-palette=\"clay\"]{--bg:#f3ead9;--fg:#1f1a17;--ac:#d9572b;--a2:#e8d3b4}\n  .pg[data-palette=\"midnight\"]{--bg:#0e1326;--fg:#f1f3ff;--ac:#c6f24e;--a2:#232b52}\n  .pg[data-palette=\"moss\"]{--bg:#e6ecd9;--fg:#1d2b1f;--ac:#2f6b4a;--a2:#c9d6b5}\n  .pg[data-palette=\"bloom\"]{--bg:#ffe3ea;--fg:#3a0d2e;--ac:#e0245e;--a2:#ffb8c9}\n\n  .hero{position:relative;overflow:hidden;display:flex;flex-direction:column;min-height:320px;padding:14px 16px;border-radius:12px;background:var(--bg);color:var(--fg);transition:background .3s,color .3s}\n  .nav{display:flex;gap:14px;align-items:center;font-size:11px;position:relative;z-index:1}\n  .nav b{margin-right:auto;font-size:13px;letter-spacing:-.01em}\n  .nav span{opacity:.7}\n  .body{flex:1;display:grid;gap:14px;margin:14px 0;position:relative}\n  .copy{position:relative;z-index:1;display:flex;flex-direction:column;justify-content:center;min-width:0}\n  .eyebrow{font-size:10px;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin-bottom:10px}\n  .hl{margin:0 0 10px;font-size:var(--hs,36px);line-height:1.05;letter-spacing:-.02em;overflow-wrap:anywhere;color:var(--fg)}\n  .hl em{color:var(--ac)}\n  .sub{margin:0 0 14px;font-size:12px;line-height:1.5;opacity:.8;max-width:34ch}\n  .cta{display:flex;gap:12px;align-items:center;flex-wrap:wrap;font-size:11px}\n  .btn{background:var(--ac);color:var(--bg);padding:7px 12px;border-radius:999px;font-weight:600}\n  .link{text-decoration:underline;text-underline-offset:3px}\n  .art{position:relative;overflow:hidden;border-radius:10px;background:var(--ac);min-height:110px;transition:background .3s}\n  .art i{position:absolute;display:block;transition:background .3s}\n  .a1{width:70%;aspect-ratio:1;border-radius:50%;background:var(--a2);top:12%;left:15%}\n  .a2{width:46%;height:42%;right:8%;bottom:0;border-radius:999px 999px 0 0;background:var(--fg)}\n  .a3{width:12px;height:12px;border-radius:50%;background:var(--bg);top:10px;right:10px}\n  .foot{display:flex;gap:14px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding-top:9px;border-top:1px solid var(--fg);position:relative;z-index:1}\n  .foot span:last-child{margin-left:auto}\n\n  /* Editorial */\n  .pg[data-layout=\"editorial\"] .body{grid-template-columns:1fr 64px}\n  .pg[data-layout=\"editorial\"] .hl{font-family:\"Iowan Old Style\",\"Palatino Linotype\",Palatino,Georgia,serif;font-weight:400}\n  .pg[data-layout=\"editorial\"] .hl em{font-style:italic}\n  .pg[data-layout=\"editorial\"] .art{border-radius:999px}\n  .pg[data-layout=\"editorial\"] .a2{width:100%;right:0}\n  /* Split */\n  .pg[data-layout=\"split\"] .body{grid-template-columns:1fr 1fr}\n  .pg[data-layout=\"split\"] .hl{font-size:calc(var(--hs,36px)*.8);font-weight:700}\n  .pg[data-layout=\"split\"] .hl em{font-style:normal}\n  .pg[data-layout=\"split\"] .foot{border-top-color:transparent;opacity:.7}\n  /* Poster */\n  .pg[data-layout=\"poster\"] .body{grid-template-columns:1fr;text-align:center}\n  .pg[data-layout=\"poster\"] .copy{align-items:center}\n  .pg[data-layout=\"poster\"] .hl{font-weight:900;text-transform:uppercase;line-height:.92;letter-spacing:-.035em}\n  .pg[data-layout=\"poster\"] .hl em{font-style:normal}\n  .pg[data-layout=\"poster\"] .cta{justify-content:center}\n  .pg[data-layout=\"poster\"] .art{position:absolute;inset:-14px -16px;background:transparent;border-radius:0}\n  .pg[data-layout=\"poster\"] .a1{width:240px;top:50%;left:50%;transform:translate(-50%,-50%)}\n  .pg[data-layout=\"poster\"] .a2{width:70px;height:70px;border-radius:50%;background:var(--ac);right:10%;bottom:8%}\n  .pg[data-layout=\"poster\"] .a3{display:none}\n  .pg[data-layout=\"poster\"] .foot{justify-content:center;border-top:0}\n  .pg[data-layout=\"poster\"] .foot span:last-child{margin-left:0}\n</style>\n\n<div id=\"pg\" class=\"pg\" data-layout=\"editorial\" data-palette=\"clay\" style=\"--hs:36px\">\n  <div class=\"controls\">\n    <div class=\"row\">\n      <span class=\"lab\">Layout</span>\n      <div class=\"seg\">\n        <button id=\"l-editorial\">Editorial</button>\n        <button id=\"l-split\">Split</button>\n        <button id=\"l-poster\">Poster</button>\n      </div>\n    </div>\n    <div class=\"row\">\n      <span class=\"lab\">Palette</span>\n      <div class=\"sws\">\n        <button class=\"sw\" id=\"p-clay\" title=\"Clay\" aria-label=\"Clay\"></button>\n        <button class=\"sw\" id=\"p-midnight\" title=\"Midnight\" aria-label=\"Midnight\"></button>\n        <button class=\"sw\" id=\"p-moss\" title=\"Moss\" aria-label=\"Moss\"></button>\n        <button class=\"sw\" id=\"p-bloom\" title=\"Bloom\" aria-label=\"Bloom\"></button>\n      </div>\n    </div>\n    <div class=\"row\">\n      <span class=\"lab\">Headline</span>\n      <input id=\"size\" type=\"range\" min=\"24\" max=\"56\" step=\"2\" value=\"36\" aria-label=\"Headline size\">\n      <span id=\"sz\">36px</span>\n    </div>\n  </div>\n\n  <div class=\"hero\">\n    <div class=\"nav\"><b>Field®</b><span>Work</span><span>Studio</span><span>Contact</span></div>\n    <div class=\"body\">\n      <div class=\"copy\">\n        <div class=\"eyebrow\">Creative studio · est. 2014</div>\n        <h2 class=\"hl\">We shape brands that feel <em>alive</em>.</h2>\n        <p class=\"sub\">Identity, motion and digital for people building things worth noticing.</p>\n        <div class=\"cta\"><span class=\"btn\">See the work →</span><span class=\"link\">Showreel 2026</span></div>\n      </div>\n      <div class=\"art\"><i class=\"a1\"></i><i class=\"a2\"></i><i class=\"a3\"></i></div>\n    </div>\n    <div class=\"foot\"><span>Branding</span><span>Motion</span><span>Web</span></div>\n  </div>\n</div>\n\n",
