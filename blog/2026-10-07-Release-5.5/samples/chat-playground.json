div>\n    <div class=\"row\">\n      <span class=\"lab\">Palette</span>\n      <div class=\"sws\">\n        <button class=\"sw\" id=\"p-clay\" title=\"Clay\" aria-label=\"Clay\"></button>\n        <button class=\"sw\" id=\"p-midnight\" title=\"Midnight\" aria-label=\"Midnight\"></button>\n        <button class=\"sw\" id=\"p-moss\" title=\"Moss\" aria-label=\"Moss\"></button>\n        <button class=\"sw\" id=\"p-bloom\" title=\"Bloom\" aria-label=\"Bloom\"></button>\n      </div>\n    </div>\n    <div class=\"row\">\n      <span class=\"lab\">Headline</span>\n      <input id=\"size\" type=\"range\" min=\"24\" max=\"56\" step=\"2\" value=\"36\" aria-label=\"Headline size\">\n      <span id=\"sz\">42px</span>\n    </div>\n  </div>\n\n  <div class=\"hero\">\n    <div class=\"nav\"><b>Field®</b><span>Work</span><span>Studio</span><span>Contact</span></div>\n    <div class=\"body\">\n      <div class=\"copy\">\n        <div class=\"eyebrow\">Creative studio · est. 2014</div>\n        <h2 class=\"hl\">We shape brands that feel <em>alive</em>.</h2>\n        <p class=\"sub\">Identity, motion and digital for people building things worth noticing.</p>\n        <div class=\"cta\"><span class=\"btn\">See the work →</span><span class=\"link\">Showreel 2026</span></div>\n      </div>\n      <div class=\"art\"><i class=\"a1\"></i><i class=\"a2\"></i><i class=\"a3\"></i></div>\n    </div>\n    <div class=\"foot\"><span>Branding</span><span>Motion</span><span>Web</span></div>\n  </div>\n</div>\n\n<style>.pg{max-width:none}.lab{flex:0 0 70px;white-space:nowrap}.demo-heading{margin:0 0 14px;font:600 21px/1.3 system-ui;color:#eee;letter-spacing:-.3px}.demo-heading small{display:block;margin-bottom:5px;font:10px/1.4 system-ui;letter-spacing:1.8px;color:#a1a8a1}</style>",
